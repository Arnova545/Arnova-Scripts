local function BuildScriptsTab(parentFrame)
	parentFrame.BackgroundTransparency = 1
	local PADDING = 15

	local SearchBarFrame = Instance.new("Frame")
	SearchBarFrame.Size = UDim2.new(1, -(PADDING * 2), 0, 50)
	SearchBarFrame.Position = UDim2.new(0, PADDING, 0, PADDING)
	SearchBarFrame.BackgroundColor3 = THEME.TopBarColor
	SearchBarFrame.BorderSizePixel = 0
	SearchBarFrame.Parent = parentFrame
	
	Instance.new("UICorner", SearchBarFrame).CornerRadius = UDim.new(0, 10)
	Instance.new("UIStroke", SearchBarFrame).Color = THEME.StrokeColor

	local SearchIcon = CreateLabel(SearchBarFrame, "🔍", UDim2.new(0, 15, 0, 0), UDim2.new(0, 30, 1, 0), THEME.Font_Reg, THEME.TextColor_Dim, 16)
	SearchIcon.TextXAlignment = Enum.TextXAlignment.Center

	local SearchBox = Instance.new("TextBox")
	SearchBox.Size = UDim2.new(1, -60, 1, 0)
	SearchBox.Position = UDim2.new(0, 50, 0, 0)
	SearchBox.BackgroundTransparency = 1
	SearchBox.PlaceholderText = "Suche nach Scripts (z.B. Blox Fruits)..."
	SearchBox.PlaceholderColor3 = THEME.TextColor_Dim
	SearchBox.Text = ""
	SearchBox.TextColor3 = THEME.TextColor
	SearchBox.Font = THEME.Font_Reg
	SearchBox.TextSize = 16
	SearchBox.Parent = SearchBarFrame

	local ResultsScroll = Instance.new("ScrollingFrame")
	ResultsScroll.Size = UDim2.new(1, -(PADDING * 2), 1, -80)
	ResultsScroll.Position = UDim2.new(0, PADDING, 0, 75)
	ResultsScroll.BackgroundTransparency = 1
	ResultsScroll.ScrollBarThickness = 4
	ResultsScroll.ScrollBarImageColor3 = THEME.StrokeColor
	ResultsScroll.Parent = parentFrame

	local GridLayout = Instance.new("UIGridLayout")
	GridLayout.CellSize = UDim2.new(0.32, -(PADDING/3), 0, 130)
	GridLayout.CellPadding = UDim2.new(0.02, 0, 0, 15)
	GridLayout.Parent = ResultsScroll

	local function SearchScripts(query)
		for _, child in ipairs(ResultsScroll:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end

		if query == "" then return end

		task.spawn(function()
			local success, result = pcall(function()
				local url = "https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(query)
				local response = game:HttpGet(url)
				return HttpService:JSONDecode(response)
			end)

			if success and result and result.result and result.result.scripts then
				for _, scriptData in ipairs(result.result.scripts) do
					local Card = CreateBeautifulCard(ResultsScroll, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0))

					local titleText = scriptData.title or "Unbenanntes Script"
					local titleLabel = CreateLabel(Card, titleText, UDim2.new(0, 12, 0, 12), UDim2.new(1, -90, 0, 22), THEME.Font_Bold, THEME.TextColor, 13)
					titleLabel.TextTruncate = Enum.TextTruncate.AtEnd

					local gameName = scriptData.game and scriptData.game.name or "Universal Script"
					local gameLabel = CreateLabel(Card, gameName, UDim2.new(0, 12, 0, 34), UDim2.new(1, -24, 0, 20), THEME.Font_Reg, THEME.TextColor_Dim, 12)
					gameLabel.TextTruncate = Enum.TextTruncate.AtEnd

					local views = scriptData.views or 0
					CreateLabel(Card, views .. " Views", UDim2.new(0, 12, 1, -55), UDim2.new(0.6, 0, 0, 20), THEME.Font_Reg, THEME.TextColor_Dim, 11)

					local Badge = Instance.new("Frame")
					Badge.Size = UDim2.new(0, 70, 0, 22)
					Badge.Position = UDim2.new(1, -80, 0, 12)
					Badge.BackgroundColor3 = Color3.fromRGB(50, 150, 255)
					Badge.Parent = Card
					Instance.new("UICorner", Badge).CornerRadius = UDim.new(0, 6)
					local bText = CreateLabel(Badge, "VERIFIED", UDim2.new(0,0,0,0), UDim2.new(1,0,1,0), THEME.Font_Bold, Color3.fromRGB(255,255,255), 10)
					bText.TextXAlignment = Enum.TextXAlignment.Center

					local ExecBtn = Instance.new("TextButton")
					ExecBtn.Size = UDim2.new(0.48, 0, 0, 28)
					ExecBtn.Position = UDim2.new(0, 12, 1, -34)
					ExecBtn.BackgroundColor3 = THEME.TabColor_Active
					ExecBtn.Text = "Ausführen"
					ExecBtn.TextColor3 = THEME.TextColor
					ExecBtn.Font = THEME.Font_Bold
					ExecBtn.TextSize = 11
					ExecBtn.AutoButtonColor = false
					ExecBtn.Parent = Card
					Instance.new("UICorner", ExecBtn).CornerRadius = UDim.new(0, 6)

					local CopyBtn = Instance.new("TextButton")
					CopyBtn.Size = UDim2.new(0.48, 0, 0, 28)
					CopyBtn.Position = UDim2.new(0.52, -4, 1, -34)
					CopyBtn.BackgroundColor3 = THEME.TabColor_Inactive
					CopyBtn.Text = "Kopieren"
					CopyBtn.TextColor3 = THEME.TextColor
					CopyBtn.Font = THEME.Font_Bold
					CopyBtn.TextSize = 11
					CopyBtn.AutoButtonColor = false
					CopyBtn.Parent = Card
					Instance.new("UICorner", CopyBtn).CornerRadius = UDim.new(0, 6)
					Instance.new("UIStroke", CopyBtn).Color = THEME.StrokeColor

					local rawScript = scriptData.script or ""

					ExecBtn.MouseButton1Click:Connect(function()
						PlayClickSound()
						if rawScript ~= "" then
							pcall(function()
								loadstring(rawScript)()
							end)
						end
					end)

					CopyBtn.MouseButton1Click:Connect(function()
						PlayClickSound()
						if rawScript ~= "" and setclipboard then
							setclipboard(rawScript)
						end
					end)
				end
			end
		end)
	end

	SearchBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			SearchScripts(SearchBox.Text)
		end
	end)
end

