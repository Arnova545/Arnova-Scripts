local function CreateLabel(parent, text, pos, size, font, color, textSize)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = pos
	label.Size = size
	label.Text = text
	label.Font = font
	label.TextColor3 = color
	label.TextSize = textSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = parent
	return label
end

local function CreateBeautifulCard(parent, size, pos)
	local Card = Instance.new("Frame")
	Card.Size = size
	Card.Position = pos
	Card.BackgroundColor3 = Color3.new(1, 1, 1)
	Card.BorderSizePixel = 0
	Card.Parent = parent
	
	Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 12)
	Instance.new("UIStroke", Card).Color = THEME.StrokeColor
	
	local Gradient = Instance.new("UIGradient")
	Gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, THEME.CardColor_Top),
		ColorSequenceKeypoint.new(1, THEME.CardColor_Bottom)
	})
	Gradient.Rotation = 90
	Gradient.Parent = Card
	
	return Card
end

