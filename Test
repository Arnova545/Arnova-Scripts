	CreateLabel(TopBar, "NOVA HUB", UDim2.new(0, 30, 0, 0), UDim2.new(0, 150, 1, 0), THEME.Font_Bold, THEME.TextColor, 26)
	
	UpdateLoading("Generiere Tab-System...", 50)

	local TabButtonContainer = Instance.new("Frame")
	TabButtonContainer.Size = UDim2.new(1, -60, 0, 45)
	TabButtonContainer.Position = UDim2.new(0, 30, 0, 80)
	TabButtonContainer.BackgroundTransparency = 1
	TabButtonContainer.Parent = MainFrame

	local UIListLayout = Instance.new("UIListLayout")
	UIListLayout.FillDirection = Enum.FillDirection.Horizontal
	UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	UIListLayout.Padding = UDim.new(0, 15) 
	UIListLayout.Parent = TabButtonContainer

	local TabContentContainer = Instance.new("Frame")
	TabContentContainer.Size = UDim2.new(1, -60, 1, -150)
	TabContentContainer.Position = UDim2.new(0, 30, 0, 135)
	TabContentContainer.BackgroundTransparency = 1
	TabContentContainer.Parent = MainFrame
	
	UpdateLoading("Registriere Tabs...", 70)

	local tabs = {}
	local currentActiveTab = nil

	local function CreateTab(tabName, layoutOrder)
		local Button = Instance.new("TextButton")
		Button.Name = tabName .. "TabButton"
		Button.Size = UDim2.new(0, 140, 1, 0)
		Button.BackgroundColor3 = THEME.TabColor_Inactive
		Button.AutoButtonColor = false 
		Button.Text = tabName
		Button.TextColor3 = THEME.TextColor_Dim
		Button.TextSize = 16
		Button.Font = THEME.Font_Reg
		Button.LayoutOrder = layoutOrder
		Button.Parent = TabButtonContainer
		
		Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 10)
		local UIStroke = Instance.new("UIStroke")
		UIStroke.Color = THEME.StrokeColor
		UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		UIStroke.Parent = Button

		local ContentFrame = Instance.new("CanvasGroup")
		ContentFrame.Size = UDim2.new(1, 0, 1, 0)
		ContentFrame.BackgroundTransparency = 1 
		ContentFrame.BorderSizePixel = 0
		ContentFrame.GroupTransparency = 1 
		ContentFrame.Visible = false
		ContentFrame.Parent = TabContentContainer

		Button.MouseEnter:Connect(function()
			if currentActiveTab ~= tabName then TweenService:Create(Button, TWEEN_HOVER, {BackgroundColor3 = THEME.TabColor_Hover}):Play() end
		end)
		Button.MouseLeave:Connect(function()
			if currentActiveTab ~= tabName then TweenService:Create(Button, TWEEN_HOVER, {BackgroundColor3 = THEME.TabColor_Inactive}):Play() end
		end)

		tabs[tabName] = { Button = Button, Content = ContentFrame, Stroke = UIStroke }
	end

	local function SetActiveTab(activeTabName)
		if currentActiveTab == activeTabName then return end
		currentActiveTab = activeTabName

		for name, data in pairs(tabs) do
			if name == activeTabName then
				TweenService:Create(data.Button, TWEEN_SWITCH, {BackgroundColor3 = THEME.TabColor_Active, TextColor3 = THEME.TextColor}):Play()
				data.Button.Font = THEME.Font_Bold
				data.Stroke.Color = THEME.AccentColor
				data.Content.Visible = true
				TweenService:Create(data.Content, TWEEN_SWITCH, {GroupTransparency = 0}):Play()
			else
				TweenService:Create(data.Button, TWEEN_SWITCH, {BackgroundColor3 = THEME.TabColor_Inactive, TextColor3 = THEME.TextColor_Dim}):Play()
				data.Button.Font = THEME.Font_Reg
				data.Stroke.Color = THEME.StrokeColor
				local fadeOut = TweenService:Create(data.Content, TWEEN_SWITCH, {GroupTransparency = 1})
				fadeOut:Play()
				task.delay(0.35, function() if currentActiveTab ~= name then data.Content.Visible = false end end)
			end
		end
	end

	CreateTab("Home", 1)
	CreateTab("Scripts", 2)
	
	UpdateLoading("Erstelle Dashboard Layout...", 90)
	
	BuildHomeDashboard(tabs["Home"].Content)
	BuildScriptsTab(tabs["Scripts"].Content)
	SetActiveTab("Home")

	for name, data in pairs(tabs) do
		data.Button.MouseButton1Click:Connect(function()
			PlayClickSound()
			SetActiveTab(name)
		end)
	end
	
	UpdateLoading("Ladevorgang abgeschlossen!", 100)

	local function ToggleUI()
		if not isLoaded or isAnimating then return end 
		isAnimating = true
		UI_OPEN = not UI_OPEN

		if UI_OPEN then
			MainFrame.Visible = true
			local tween = TweenService:Create(MainFrame, TWEEN_SLIDE, {Position = UDim2.new(0, 0, 0, 0), GroupTransparency = 0})
			tween:Play()
			tween.Completed:Wait()
		else
			local tween = TweenService:Create(MainFrame, TWEEN_SLIDE, {Position = UDim2.new(1, 0, 1, 0), GroupTransparency = 1})
			tween:Play()
			tween.Completed:Wait()
			MainFrame.Visible = false
		end
		isAnimating = false
	end

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not gameProcessed and input.KeyCode == TOGGLE_KEY then ToggleUI() end
	end)

	local fadeOutInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(LoadingTitle, fadeOutInfo, {TextTransparency = 1}):Play()
	TweenService:Create(LoadingPercent, fadeOutInfo, {TextTransparency = 1}):Play()
	TweenService:Create(LoadingStatus, fadeOutInfo, {TextTransparency = 1}):Play()
	TweenService:Create(LoadingStroke, fadeOutInfo, {Transparency = 1}):Play()
	
	local bgFade = TweenService:Create(LoadingFrame, fadeOutInfo, {BackgroundTransparency = 1})
	bgFade:Play()
	bgFade.Completed:Wait()
	
	LoadingFrame:Destroy()
	isLoaded = true

	LoadCompleteSound:Play()
	LoadCompleteSound.Ended:Connect(function()
		LoadCompleteSound:Destroy()
	end)
end)
